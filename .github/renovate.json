{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>mono0x/renovate-config:dprint-plugins",
    "github>mono0x/renovate-config:hk-pkl"
  ],
  "timezone": "Asia/Tokyo",
  "minimumReleaseAge": "2 days",
  "osvVulnerabilityAlerts": true,
  "schedule": [
    "* * 1 * *"
  ],
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "group": {
    "commitMessageTopic": "{{#if upgrades.[1]}}{{{groupName}}}{{else}}{{{depName}}}{{/if}}",
    "commitMessageExtra": "{{#unless upgrades.[1]}}to {{#if isPinDigest}}{{{newDigestShort}}}{{else}}{{#if isMajor}}{{prettyNewMajor}}{{else}}{{#if isSingleVersion}}{{prettyNewVersion}}{{else}}{{#if newValue}}{{{newValue}}}{{else}}{{{newDigestShort}}}{{/if}}{{/if}}{{/if}}{{/if}}{{/unless}}"
  },
  "packageRules": [
    {
      "description": "Automerge everything except major updates",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "groupName": "dependencies",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchManagers": [
        "mise"
      ],
      "groupName": "mise tools",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    },
    {
      "matchDepNames": [
        "hk-pkl"
      ],
      "groupName": "mise tools",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ]
    }
  ]
}
