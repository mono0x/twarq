amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["cargo-fmt"] = Builtins.cargo_fmt
  ["dprint"] = (Builtins.dprint) {
    glob = "**/*.{json,jsonc,md,yaml,yml,toml}"
  }
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["jactionlint"] {
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml", "**/action.{yml,yaml}")
    batch = true
    diagnostic_format = "sarif"
    check = "jactionlint --format sarif {{files}}"
    check_diff = "hk util sarif-diff -- jactionlint --format sarif {{files}}"
    fix = "jactionlint --fix {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["post-tool-use"] {
    fix = true
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
