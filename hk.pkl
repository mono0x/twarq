amends "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v1.54.0/hk@1.54.0#/Builtins.pkl"

local formatters = new Mapping<String, Step> {
  ["dprint"] = (Builtins.dprint) {
    glob = "**/*.{json,jsonc,md,yaml,yml,toml}"
  }
  ["pkl-format"] = Builtins.pkl_format
  ["cargo-fmt"] = Builtins.cargo_fmt
}

local linters = (formatters) {
  ["pkl"] = Builtins.pkl
  ["cargo-clippy"] = (Builtins.cargo_clippy) {
    check = "cargo clippy --all-targets --all-features -- -D warnings"
    fix =
      "cargo clippy --all-targets --all-features --fix --allow-dirty --allow-staged -- -D warnings"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["post-tool-use"] {
    fix = true
    steps = formatters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
