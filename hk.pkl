amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
  ["cargo-fmt"] = Builtins.cargo_fmt
  ["dprint"] = (Builtins.dprint) {
    glob = "**/*.{json,jsonc,md,yaml,yml,toml}"
  }
  ["pkl"] = Builtins.pkl
  ["pkl-format"] = Builtins.pkl_format
  ["jactionlint"] {
    glob = List(".github/workflows/*.{yml,yaml}", "**/action.{yml,yaml}")
    batch = true
    check = "jactionlint {{files}}"
    fix = "jactionlint --fix {{files}}"
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["post-tool-use"] {
    fix = true
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
